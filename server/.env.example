# ── Clerk (same secret key as frontend) ──────────────────────────────────────
CLERK_SECRET_KEY=sk_test_YOUR_KEY_HERE

# ── Supabase Admin ───────────────────────────────────────────────────────────
# Get from https://supabase.com → your project → Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...YOUR_FULL_SERVICE_ROLE_KEY_HERE

# ── Server Config ────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ── Server-to-server auth (must match frontend INTERNAL_API_SECRET) ──────────
INTERNAL_API_SECRET=internal-GENERATE-A-UUID-HERE
