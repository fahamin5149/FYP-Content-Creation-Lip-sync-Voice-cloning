# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (block all .env variants, allow .env.example everywhere)
.env*
!*.env.example
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python virtual environment
venv/

# Python cache files
__pycache__/
*.pyc
*.pyo

database.txt

/TTS_Models

# Large output/upload directories (not tracked in git)
# Ignore file contents but keep folder structure via .gitkeep
TTS_Output/
uploads/**
!uploads/**/
!uploads/**/.gitkeep
server/uploads/**
!server/uploads/**/
!server/uploads/**/.gitkeep

prompts/

coqui-ai-TTS/
fyp-standee-groupmate-fixed (1).html
fyp-standee-mockup copy.html
fyp-standee-mockup.html
urdu_voice_clone_logic.txt

# Python virtual environments (named venvs — not just 'venv/')
english_tts_env/
urdu_tts_env/

# English TTS runtime artifacts
English_TTS/englishttts/Output_audios/
English_TTS/englishttts/input_audios/

# Compiled TypeScript in server/src (tsc outputs in-place, no outDir set)
server/src/**/*.js
server/src/**/*.js.map
server/src/**/*.d.ts.map
server/src/config/**/*.d.ts
server/src/controllers/**/*.d.ts
server/src/db/**/*.d.ts
server/src/middleware/**/*.d.ts
server/src/routes/**/*.d.ts
server/src/index.d.ts

# Claude Code workspace
.claude/

