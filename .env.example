# ── Clerk Authentication ──────────────────────────────────────────────────────
# Get from https://dashboard.clerk.com → your project → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE
CLERK_SECRET_KEY=sk_test_YOUR_KEY_HERE

# ── Clerk Routes ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ── Backend API ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000

# ── Python TTS Services ─────────────────────────────────────────────────────
PYTHON_TTS_URL=http://localhost:8000
URDU_TTS_URL=http://localhost:8001

# ── Server-to-server auth ────────────────────────────────────────────────────
# Generate a random secret: node -e "console.log('internal-'+require('crypto').randomUUID())"
INTERNAL_API_SECRET=internal-GENERATE-A-UUID-HERE

# ── App URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
